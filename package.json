{
  "name": "media-saver",
  "description": "Скачивание медиа из соцсетей одним кликом",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "pack": "node scripts/pack.mjs",
    "icons": "node scripts/icons.mjs",
    "zip": "wxt zip",
    "dev:youtube": "wxt -c wxt.youtube.config.ts",
    "build:youtube": "wxt build -c wxt.youtube.config.ts",
    "zip:youtube": "wxt zip -c wxt.youtube.config.ts",
    "compile": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^10.0.0",
    "prettier": "^3.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "mediabunny": "^1.65.0"
  }
}
